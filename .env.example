# Origin parity (production): BETTER_AUTH_URL here, NEXT_PUBLIC_BETTER_AUTH_URL
# here, and CLIENT_URL in yardclub-server/.env must be the SAME canonical HTTPS
# origin with no trailing slash. A mismatch causes 401s and session reload
# failures. API_URL must be the deployed API HTTPS origin.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DB_URL=mongodb+srv://user:password@cluster.mongodb.net/
# Deployed API HTTPS origin in production; local default is http://localhost:5000.
API_URL=http://localhost:5000

# Server-only ImgBB API key used by POST /api/uploads/imgbb.
# Never add a NEXT_PUBLIC_ prefix; this key must not reach the browser.
IMGBB_API_KEY=your_imgbb_api_key_here

# Optional: Google sign-in uses a real Better Auth social redirect and is only
# enabled when BOTH values are set. Register
# ${BETTER_AUTH_URL}/api/auth/callback/google as an authorized redirect URI
# (locally: http://localhost:3000/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
